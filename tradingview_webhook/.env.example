# TradingView Webhook 設定 (請複製為 .env 並修改)
WEBHOOK_API_KEY=tv_api_key_7x3fGh9JkLq2
WEBHOOK_SIGNATURE_SECRET=tv_sig_secret_aBcD1234EfGh5678
WEBHOOK_TIMESTAMP_TOLERANCE=300

# Bitunix API 設定 (請至 Bitunix 官網申請 API Key，勾選「讀取/交易」權限，綁定 IP)
BITUNIX_API_KEY=your_bitunix_api_key
BITUNIX_SECRET_KEY=your_bitunix_secret_key
BITUNIX_PASSPHRASE=your_bitunix_passphrase
BITUNIX_BASE_URL=https://fapi.bitunix.com

# 交易參數
TRADE_EQUITY_PERCENT=0.01      # 1% 總倉位
TRADE_LEVERAGE=10              # 固定 10x 槓桿
TRADE_SL_PERCENT=0.05          # SL 5%
TRADE_TP_PERCENT=0.05          # TP 5% (1:1)
TRADE_MARGIN_MODE=isolated     # isolated / cross